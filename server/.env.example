# ═══════════════════════════════════════════════════════════
#  Environment Variables — دیوان
#  کپی کن: cp .env.example .env
#  ویرایش کن و مقادیر را پر کن
# ═══════════════════════════════════════════════════════════

# ─── Node ───
NODE_ENV=production
PORT=4000
HOST=127.0.0.1

# ─── Database ───
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=divan
DB_USER=divan_app
DB_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# ─── JWT (ضروری: از این عوض کن!) ───
# تولید: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-TO-A-64-CHAR-RANDOM-STRING
JWT_EXPIRES_IN=30d

# ─── Admin (فقط اولین بار) ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD
ADMIN_FULL_NAME=مدیر سیستم

# ─── CORS (لیست دامنه‌های مجاز، با کاما) ───
CORS_ORIGINS=https://divan.example.com,https://divan-one.vercel.app

# ─── Trust Proxy (وقتی پشت Nginx/Caddy هستی) ───
TRUST_PROXY=1

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
