# ═══════════════════════════════════════════════════════════
#  محیط اجرای سرور دیوان
#  کپی کن: cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Node ───
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ─── Database ───
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=divan
DB_USER=divan_app
DB_PASSWORD=CHANGE-ME-DB-PASSWORD

# ─── JWT ───
# تولید: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-JWT-SECRET
JWT_EXPIRES_IN=30d

# ─── Admin (فقط اولین بار — برای setup) ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-ADMIN-PASSWORD
ADMIN_FULL_NAME=مدیر سیستم

# ─── CORS (دامنه‌های مجاز با کاما) ───
CORS_ORIGINS=*

# ─── Trust Proxy (پشت Nginx/Caddy) ───
TRUST_PROXY=0
